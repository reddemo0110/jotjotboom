<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.reddemo0110.Attic</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Attic</name>
  <summary>Retro-flavoured markdown notes</summary>
  <description>
    <p>
      Plain markdown files in a folder you own, shown the way a good editor
      shows them: headings, emphasis, tasks, tables, images and link cards
      are drawn in place while the markup stays a keystroke away. Notes are
      organised with #tags, linked with [[wiki links]], searched as you type
      and, optionally, synced between machines through a small server you
      run yourself.
    </p>
    <p>
      The editor wears one of a set of retro colour themes (phosphor
      terminals, paper, a colour buffet of your own) and its own font
      choices; the window chrome follows your desktop, including light and
      dark mode and the accent colour. Built for COSMIC, and at home on
      GNOME, where notes also turn up in the Activities overview search.
    </p>
  </description>
  <developer id="io.github.reddemo0110">
    <name>Andrew Kneebone</name>
  </developer>
  <icon type="remote" width="64" height="64" scale="1">
    https://github.com/reddemo0110/attic/raw/main/resources/icons/hicolor/scalable/apps/icon.svg
  </icon>
